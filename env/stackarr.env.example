# ---------------------------------------------------------------------------
# Stackarr — Portainer environment variables
#
# Enter these in Portainer → Stack → Environment variables.
# Do not store real secrets in this repository.
# ---------------------------------------------------------------------------

# Stackarr image; use an exact version for rollback.
STACKARR_IMAGE=polyphonic/stackarr:0.3.0-alpha.21

# General settings
TIMEZONE=Europe/Vienna

# Keep the dashboard localhost-only until authentication is configured.
STACKARR_BIND_IP=127.0.0.1
STACKARR_WEB_PORT=7777

# Host paths on the Synology NAS.
STACKARR_CONFIG=/volume1/docker/stackarr/config
MEDIA_ROOT=/volume1/data/media
DOWNLOADS_ROOT=/volume1/data/torrents
BACKUP_ROOT=/volume1/data/backup/stackarr

# Container paths inside Stackarr.
STACKARR_MEDIA_ROOT=/media
STACKARR_DOWNLOADS_ROOT=/downloads
STACKARR_BACKUP_ROOT=/backups

# Initial agent authority. Do not change without a reviewed Git change.
STACKARR_MCP_PROFILE=observe