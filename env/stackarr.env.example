# ---------------------------------------------------------------------------
# Stackarr environment template
#
# Copy to `env/stackarr.env` on the NAS / Portainer host.
# NEVER commit `env/stackarr.env`.
# ---------------------------------------------------------------------------

# --- Stackarr image ---
# Use an exact version tag for reproducible deployments and rollback.
STACKARR_IMAGE=polyphonic/stackarr:0.3.0-alpha.21

# --- General settings ---
TIMEZONE=Europe/Vienna

# Keep the dashboard bound to localhost until authentication is configured.
STACKARR_BIND_IP=127.0.0.1
STACKARR_WEB_PORT=7777

# --- Storage roots ---
# These must match the existing media-server layout.
# Host paths are mounted into the Stackarr container.
MEDIA_ROOT=/volume1/data/media
DOWNLOADS_ROOT=/volume1/data/torrents
BACKUP_ROOT=/volume1/data/backup/stackarr

# --- Container paths ---
# These are the paths Stackarr sees inside its container.
STACKARR_CONFIG=/volume1/docker/stackarr/config
STACKARR_MEDIA_ROOT=/media
STACKARR_DOWNLOADS_ROOT=/downloads
STACKARR_BACKUP_ROOT=/backups

# --- Docker access ---
# Stackarr requires the Docker socket to inspect and manage containers
# selected during setup. This must never be granted to Hermes.
# This value is normally defined directly in compose/stackarr.yml,
# not in this environment file.
# STACKARR_DOCKER_SOCKET=/var/run/docker.sock

# --- Agent authority ---
# Initial deployment must use `observe`.
# Do not set `manage`, `admin`, or `unrestricted` without a reviewed change.
STACKARR_MCP_PROFILE=observe

# --- Network names ---
# `agent` is used for Hermes-to-Stackarr communication.
# `synobridge` is the existing Synology bridge network used by the media stack.
AGENT_NETWORK=agent
MEDIA_NETWORK=synobridge

# --- Optional: Stackarr dashboard authentication ---
# Store real credentials in the NAS-side environment/secret store, not in Git.
# STACKARR_ADMIN_USERNAME=<SET_IN_SECRET_STORE>
# STACKARR_ADMIN_PASSWORD=<SET_IN_SECRET_STORE>

# --- Optional: MCP access token for Hermes ---
# If Stackarr issues or requires an MCP token, store it securely and provide it
# to Hermes through env/hermes.env—not through this file.
# STACKARR_MCP_TOKEN=<SET_IN_SECRET_STORE>