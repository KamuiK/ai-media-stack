# ---------------------------------------------------------------------------
# Hermes Agent environment template
#
# Copy to `env/hermes.env` on the NAS / Portainer host.
# NEVER commit `env/hermes.env`.
# ---------------------------------------------------------------------------

# --- Hermes image ---
# Use an exact version tag for reproducible deployment and rollback.
HERMES_IMAGE=nousresearch/hermes-agent:v2026.8.3

# --- Hermes runtime ---
TIMEZONE=Europe/Vienna

# Hermes gateway API port.
# Required for the dashboard or external API clients; optional if you only use
# a chat platform such as Telegram or Discord.
HERMES_GATEWAY_PORT=8642

# Enable the built-in web dashboard.
# The dashboard listens internally on port 9119.
HERMES_DASHBOARD=1
HERMES_DASHBOARD_PORT=9119

# Keep the dashboard restricted to localhost until authentication is configured.
HERMES_DASHBOARD_HOST=127.0.0.1

# --- Stackarr MCP connection ---
# Hermes connects only to Stackarr. It must not receive API keys for Sonarr,
# Radarr, Seerr, qBittorrent, Prowlarr, Jackett, or Jellyfin.
STACKARR_MCP_URL=http://stackarr:7777

# If Stackarr requires an MCP token, store the real value here.
# Do not put this value in Git or in Hermes config.yaml.
STACKARR_MCP_TOKEN=<SET_IN_SECRET_STORE>

# --- LLM provider ---
# Initial cloud provider: OpenRouter.
# Store the real API key only in this NAS-side .env file.
OPENROUTER_API_KEY=<SET_IN_SECRET_STORE>

# Optional: set the default model through config.yaml instead.
# This placeholder is documentation only.
# HERMES_DEFAULT_MODEL=<SET_IN_CONFIG_YAML>

# --- Chat integration ---
# Enable only the chat integration you actually use.
# Store real tokens in the NAS-side .env file.
# TELEGRAM_BOT_TOKEN=<SET_IN_SECRET_STORE>
# TELEGRAM_ALLOWED_USERS=<SET_IN_SECRET_STORE>
# DISCORD_BOT_TOKEN=<SET_IN_SECRET_STORE>
# DISCORD_HOME_CHANNEL=<SET_IN_SECRET_STORE>

# --- Dashboard authentication ---
# Required if the dashboard is reachable beyond container localhost.
# Use a long random password and keep it out of Git.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=<SET_IN_SECRET_STORE>
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=<SET_IN_SECRET_STORE>
HERMES_DASHBOARD_BASIC_AUTH_SECRET=<SET_IN_SECRET_STORE>

# --- Optional external API server ---
# Leave disabled unless another tool needs to call Hermes' OpenAI-compatible API.
API_SERVER_ENABLED=false
# If enabled, bind only where necessary and protect it with a strong key.
# API_SERVER_HOST=127.0.0.1
# API_SERVER_KEY=<SET_IN_SECRET_STORE>
# API_SERVER_CORS_ORIGINS=<SET_IN_SECRET_STORE>